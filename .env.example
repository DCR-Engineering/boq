# Copy to .env and fill in. Never commit .env.

# --- CRM (section 9 of the build prompt) ---
# Target CRM is still <<FILL IN>>. Until then the LocalFileAdapter is used and needs no keys.
CRM_ADAPTER=local_file
CRM_BASE_URL=
CRM_API_KEY=
CRM_MODULE=

# --- Vision model, used only for reading documents, never for arithmetic ---
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5

# --- Paths ---
BOQ_PROJECT_ROOT=./projects
